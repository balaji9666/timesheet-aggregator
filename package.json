{
  "name": "typescript-node-server",
  "version": "1.0.0",
  "description": "A TypeScript Node.js server",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "test": "jest",
    "generate-certs": "node scripts/generate-ssl-certs.js",
    "start:https": "npm run generate-certs && node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/node": "22.14.1",
    "glob": "^10.3.10",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "glob": "^10.3.10",
    "inflight": "^2.0.0"
  }
}
